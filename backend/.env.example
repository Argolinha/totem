
# Banco de dados (SQLite por padrão; troque para PostgreSQL em produção)
DATABASE_URL=sqlite:///./vive_photobooth.db
# Exemplo PostgreSQL: postgresql://user:password@localhost:5432/vive_photobooth

# Redis / Celery
# Dentro do Docker, use o NOME DO SERVIÇO do container Redis no docker-compose
# (ex.: "redis"), nunca "localhost" - "localhost" dentro de um container aponta
# para o próprio container do backend, não para o container do Redis.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# URL pública do backend (usada para montar o link do QR Code)
PUBLIC_BASE_URL=http://localhost:8000

# ============================================================
# Provedor de IA
# ============================================================
# "auto" (recomendado): tenta em ordem krea2_insightface -> flux_krea -> fal
#   -> insightface -> openai -> stability -> local, até um funcionar.
# Ou force um único: krea2_insightface | flux_krea | fal | insightface |
#   openai | stability | local
AI_PROVIDER=auto

# --- fal.ai (FLUX genérico, FLUX.1 Krea e Krea 2 Medium) ---
FAL_KEY=
FAL_FLUX_MODEL=fal-ai/flux/dev
FAL_FLUX_KREA_MODEL=fal-ai/flux-1/krea/image-to-image
FAL_KREA2_MODEL=fal-ai/krea/v2/medium/text-to-image

# --- InsightFace (troca de rosto local/ONNX, roda offline) ---
# Precisa do arquivo inswapper_128.onnx baixado e colocado em
# INSIGHTFACE_SWAPPER_MODEL_PATH para funcionar.
INSIGHTFACE_ENABLED=false
INSIGHTFACE_MODEL_PACK=buffalo_l
INSIGHTFACE_ROOT=./models
INSIGHTFACE_SWAPPER_MODEL_PATH=./models/inswapper_128.onnx

# --- OpenAI (fallback opcional) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Stability AI (fallback opcional) ---
STABILITY_API_KEY=

# Identificador do totem (permite múltiplos totens futuramente)
TOTEM_ID=totem-001

# Origens permitidas para CORS (separadas por vírgula) - inclua a origem
# real usada para abrir o frontend (porta do Nginx no docker-compose, IP
# do totem etc.), não só as portas do modo dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Admin
AUTH_SECRET_KEY=troque-essa-chave-em-producao
ADMIN_EMAIL=admin@vive.local
ADMIN_PASSWORD=admin123
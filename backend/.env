# Banco de dados (SQLite por padrão; troque para PostgreSQL em produção)
DATABASE_URL=sqlite:///./vive_photobooth.db
# Exemplo PostgreSQL: postgresql://user:password@localhost:5432/vive_photobooth

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# URL pública do backend (usada para montar o link do QR Code)
PUBLIC_BASE_URL=http://localhost:8000

# Provedor de IA: mock | replicate | stability | openai
AI_PROVIDER=mock
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
OPENAI_API_KEY=

# Identificador do totem (permite múltiplos totens futuramente)
TOTEM_ID=totem-001

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
